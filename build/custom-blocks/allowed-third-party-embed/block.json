{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wb-blocks/allowed-third-party-embed",
  "title": "Allowed third party embed",
  "description": "Add code from an allowed third party provider",
  "category": "wb-blocks",
  "icon": "embed-generic",
  "keywords": [
    "html",
    "third party embed",
    "smart survey",
    "ticket tailor",
    "script"
  ],
  "textdomain": "wb_blocks",
  "editorScript": "wb-blocks-editor-script",
  "supports": {
    "html": false
  },
  "attributes": {
    "embedCode": {
      "type": "string",
      "default": ""
    },
    "provider": {
      "type": "string",
      "default": ""
    },
    "validationStatus": {
      "type": "string",
      "default": "not-validated"
    },
    "validationMessage": {
      "type": "string",
      "default": ""
    }
  }
}