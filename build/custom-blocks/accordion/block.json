{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wb-blocks/accordion",
  "title": "Accordion",
  "description": "Display content in an accordion component.",
  "category": "wb-blocks",
  "icon": "list-view",
  "keywords": [
    "accordion",
    "sections",
    "lists"
  ],
  "textdomain": "wb_blocks",
  "editorScript": "wb-blocks-editor-script",
  "providesContext": {
    "wb-blocks/accordionHeadingLevel": "headingLevel",
    "wb-blocks/accordionHeadingFontSize": "headingFontSize"
  },
  "attributes": {
    "openAll": {
      "type": "string",
      "default": "Expand all sections"
    },
    "closeAll": {
      "type": "string",
      "default": "Collapse all sections"
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "headingFontSize": {
      "type": "string",
      "default": "base"
    },
    "accordionClassName": {
      "type": "string"
    }
  }
}