{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wb-blocks/icon",
  "title": "Icon",
  "description": "Choose from a whole plethora of icons",
  "category": "wb-blocks",
  "keywords": [
    "icon"
  ],
  "textdomain": "wb_blocks",
  "editorScript": "wb-blocks-editor-script",
  "attributes": {
    "icon": {
      "type": "string",
      "default": "action/group_work"
    },
    "iconStyle": {
      "type": "string",
      "default": ""
    },
    "availableStyles": {
      "type": "array",
      "default": [
        {
          "label": "Standard",
          "value": ""
        },
        {
          "label": "Outlined",
          "value": "outlined"
        },
        {
          "label": "Rounded",
          "value": "round"
        },
        {
          "label": "Sharp",
          "value": "sharp"
        },
        {
          "label": "Two-tone",
          "value": "twotone"
        }
      ]
    },
    "size": {
      "type": "number",
      "default": 6
    },
    "colour": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "className": {
      "type": "string"
    }
  }
}